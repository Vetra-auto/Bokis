{
  "$schema": "https://raw.githubusercontent.com/nicholashaemmerle/tauri-schema/main/tauri.conf.json.schema",
  "productName": "Bokis",
  "version": "0.1.0",
  "identifier": "se.bokforing.bokis",
  "build": {
    "frontendDist": "../bokforing-ui/dist",
    "beforeBuildCommand": "cd bokforing-ui && trunk build --release",
    "beforeDevCommand": "cd bokforing-ui && trunk serve --port 1420 --open false"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bokis",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "shortDescription": "Svenskt bokföringssystem (BFL-kompatibelt)",
    "category": "Finance",
    "linux": {
      "deb": {
        "depends": ["libgtk-3-0", "libwebkit2gtk-4.1-0", "librsvg2-2"],
        "section": "finance"
      }
    }
  }
}
